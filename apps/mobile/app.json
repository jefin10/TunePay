{
  "expo": {
    "name": "TunePay",
    "slug": "tunepay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tunepay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jefin10.tunepay",
      "supportsTablet": false
    },
    "android": {
      "package": "com.jefin10.tunepay",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0D11",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TunePay uses the microphone for voice payments.",
          "speechRecognitionPermission": "TunePay uses speech recognition to understand voice commands."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TunePay uses Face ID to confirm it's you before payments."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TunePay uses the camera to scan UPI QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "TunePay reads your contacts so you can pay them quickly."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TunePay reads QR codes from images you pick."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "TunePay saves your payment QR code to your photos."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
